# Session signing secret — REQUIRED in production.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Optional: lock first-time WebAuthn registration behind a shared secret
# (send as header x-register-secret or ?secret=)
REGISTER_SECRET=

# Set true only when intentionally replacing the admin security key
ALLOW_WEBAUTHN_REREGISTER=false

# Pin WebAuthn RP (recommended in production)
WEBAUTHN_RP_ID=www.mufix.co.uk
WEBAUTHN_ORIGIN=https://www.mufix.co.uk

# Storage — prefer Upstash REST on Vercel serverless
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional TCP Redis (local / long-running Node). Ignored if Upstash is set.
REDIS_URL=

# Vercel Blob — image uploads in production
BLOB_READ_WRITE_TOKEN=
