# Redis — for production on Vercel
# Set this env var in your Vercel project settings (Settings → Environment Variables).
# Locally it's read from .env or falls back to server/data/*.json files.
REDIS_URL=

# Session signing secret — MUST be set in production (Vercel → Settings → Environment Variables).
# Generate a strong random value: openssl rand -hex 32
# Without this, the dev fallback is used, which is not safe in production.
SESSION_SECRET=

# Vercel Blob — for image uploads.
# Get from: Vercel dashboard → Storage → your Blob store → .env.local
# Without this, local dev falls back to base64 (fine locally, don't deploy without it).
BLOB_READ_WRITE_TOKEN=
